DECKS_ENV=development
DECKS_PUBLIC_BASE_URL=http://127.0.0.1:5240
DECKS_APP_KEY=replace-with-a-local-random-value
DECKS_DB_HOST=127.0.0.1
DECKS_DB_PORT=5432
DECKS_DB_NAME=decks
DECKS_DB_USER=decks
DECKS_DB_PASSWORD=replace-me
DECKS_ASSET_PATH=storage/assets
DECKS_ASSET_HANDOFF_PREFIX=/_protected-decks-assets
DECKS_REALTIME_BIND=127.0.0.1:5242
DECKS_REALTIME_SIGNING_KEY=replace-me
DECKS_REALTIME_DB_HOST=127.0.0.1
DECKS_REALTIME_DB_PORT=5432
DECKS_REALTIME_DB_NAME=decks
DECKS_REALTIME_DB_USER=decks_realtime
DECKS_REALTIME_DB_PASSWORD=replace-me
DECKS_MAIL_FROM=Decks <no-reply@example.test>
DECKS_SMTP_HOST=127.0.0.1
DECKS_SMTP_PORT=1025
DECKS_SMTP_SECURITY=none
DECKS_SMTP_USERNAME=
DECKS_SMTP_PASSWORD=
